DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=studyspace
DB_PASSWORD=ganti-dengan-kata-sandi-database
DB_NAME=study
UPLOAD_DIR=storage/uploads
# Isi 1 hanya jika reverse proxy menimpa (bukan meneruskan) X-Forwarded-For dan X-Forwarded-Proto.
# Contoh nginx: proxy_set_header X-Forwarded-For $remote_addr;
#               proxy_set_header X-Forwarded-Proto $scheme;
#               client_max_body_size 26m;
# Jangan jalankan next start sebagai root. Pakai user database dari database/app-user.sql.
TRUST_PROXY=0
